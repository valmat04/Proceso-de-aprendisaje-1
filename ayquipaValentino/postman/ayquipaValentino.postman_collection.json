{
  "info": {
    "name": "ayquipaValentino — HUB01 y HUB02",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "inspectorUsername",
      "value": "inspector"
    },
    {
      "key": "inspectorPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "HUB01 — Registrar zona 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/zones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sector totoral\",\n  \"location\": \"Humedal, sector 1\",\n  \"areaHectares\": 10,\n  \"interventionDate\": \"14/10/2026\",\n  \"status\": \"EN RESTAURACIÓN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Objeto creado\", () => pm.expect(pm.response.json().idZona).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    },
