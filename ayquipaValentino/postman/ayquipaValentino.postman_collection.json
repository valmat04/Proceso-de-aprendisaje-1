    {
      "name": "Login INSPECTOR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{inspectorUsername}}\",\n  \"password\": \"{{inspectorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "HUB02 — Reporte con INSPECTOR",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/monitors"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Reporte JSON\", function () { const rows=pm.response.json(); pm.expect(rows).to.be.an(\"array\"); rows.forEach(r => { pm.expect(r).to.have.keys(\"date\", \"cantidad \"); pm.expect(r.date).to.match(/^\\d{2}\\/\\d{2}\\/\\d{4}$/); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "HUB02 — Sin token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/monitors"
